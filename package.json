{
  "name": "uploadthing-ui",
  "version": "0.1.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "24.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "lint": "oxlint . && bun run scripts/check-file-lines.ts",
    "lint:changed": "bun run scripts/lint-changed.ts",
    "lint:fix": "oxlint --fix .",
    "lint:staged": "oxlint --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt --write -c .oxfmtrc.json \"**/*.{cjs,mjs,js,jsx,ts,tsx,json,jsonc,md}\"",
    "format:check": "oxfmt --check -c .oxfmtrc.json \"**/*.{cjs,mjs,js,jsx,ts,tsx,json,jsonc,md}\"",
    "check": "oxlint . && oxfmt --check -c .oxfmtrc.json \"**/*.{cjs,mjs,js,jsx,ts,tsx,json,jsonc,md}\"",
    "check:fix": "oxlint --fix . && oxfmt --write -c .oxfmtrc.json \"**/*.{cjs,mjs,js,jsx,ts,tsx,json,jsonc,md}\"",
    "deslop": "bun run scripts/deslop.ts",
    "knip": "knip",
    "knip:deps": "knip --dependencies",
    "type-check": "tsc --noEmit",
    "registry:build": "shadcn build"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@uploadthing/react": "^7.3.3",
    "@uploadthing/shared": "^7.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "deslop-cli": "^0.9.12",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
